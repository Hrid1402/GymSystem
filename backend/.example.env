# =============================================================================
# BASE DE DATOS POSTGRESQL (UNIFICADA EN SUPABASE)
# =============================================================================
# Opción 1 (Supabase Local mediante CLI con Docker Desktop en ejecución):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Opción 2 (Supabase Cloud en producción o remoto):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

PORT=3000
FRONTEND_URL="http://localhost:5173"

# =============================================================================
# SUPABASE (Auth & API)
# =============================================================================
# Para Supabase Local (requiere Docker Desktop y ejecutar: npx supabase start):
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Para Supabase Cloud:
# SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# =============================================================================
# CREDENCIALES DEL GERENTE INICIAL (SEED)
# =============================================================================
INITIAL_MANAGER_EMAIL="manager@gmail.com"
INITIAL_MANAGER_PASSWORD="SuperSecurePassword123!"
INITIAL_MANAGER_NAME="Chief Manager"

# =============================================================================
# CULQI CHECKOUT v4 (PASARELA DE PAGOS)
# =============================================================================
# Secret Key privada de CulqiPanel (sk_test_... en desarrollo o sk_live_... en producción)
CULQI_SECRET_KEY=""

# Webhook secret opcional para verificar firma de notificaciones
CULQI_WEBHOOK_SECRET=""
